{
  "compileOnSave": false,
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "declaration": true,
    "emitDeclarationOnly": false,
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "ignoreDeprecations": "6.0",
    "rootDir": "./src",
    "types": ["node"],
    "module": "ESNext",
    "target": "ES2019"
  },
  "include": ["src/**/*.ts"],
  "exclude": ["dist"]
}
