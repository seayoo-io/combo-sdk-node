{
  "name": "@seayoo-io/combo-sdk-node",
  "version": "1.8.1",
  "description": "Combo SDK for Node.js",
  "type": "module",
  "source": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rimraf ./dist && node preconvert.cjs && tsdown",
    "preconvert": "node preconvert.cjs",
    "dev": "tsdown --watch",
    "clear": "rimraf dist && rimraf node_modules",
    "type-check": "tsc --noEmit -p tsconfig.typecheck.json",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest",
    "test:run": "vitest run",
    "test:src": "vitest run --project src",
    "test:dist": "vitest run --project dist --project contract",
    "check:publish": "publint && attw --pack .",
    "verify:node12": "node scripts/verify-node12.mjs",
    "verify:all": "pnpm type-check && pnpm lint && pnpm build && pnpm test:run && pnpm check:publish && pnpm verify:node12",
    "prepublishOnly": "pnpm type-check && pnpm lint && pnpm build && pnpm test:run && pnpm check:publish"
  },
  "engines": {
    "node": ">=12"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint && pnpm type-check"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seayoo-io/combo-sdk-node.git"
  },
  "keywords": [
    "combo",
    "seayoo",
    "server"
  ],
  "author": "seayoo.io",
  "license": "MIT",
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/koa": "^2.13.12",
    "@types/node": "22.20.1",
    "acorn": "^8.18.0",
    "ioredis": "^5.4.1",
    "lint-staged": "^17.3.0",
    "msw": "^2.15.0",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "publint": "^0.3.23",
    "rimraf": "^6.1.3",
    "simple-git-hooks": "^2.13.1",
    "tsdown": "0.21.0",
    "typescript": "6.0.3",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "jsonwebtoken": "^9.0.2"
  }
}
