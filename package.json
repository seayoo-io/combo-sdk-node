{
  "name": "@seayoo-io/combo-sdk-node",
  "version": "1.7.0",
  "description": "Combo SDK for Node.js",
  "type": "module",
  "source": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "exports": {
    "types": "./dist/index.d.ts",
    "import": "./dist/index.js",
    "require": "./dist/index.cjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rimraf ./dist && node preconvert.cjs && microbundle --sourcemap false --format cjs,es --target node",
    "preconvert": "node preconvert.cjs",
    "dev": "microbundle watch --target node",
    "clear": "rimraf dist && rimraf node_modules",
    "type-check": "tsc --noEmit -p tsconfig.typecheck.json",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest",
    "prepublishOnly": "pnpm type-check && pnpm lint:fix && vitest run && pnpm build"
  },
  "engines": {
    "node": ">=12"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint && pnpm type-check"
  },
  "repository": "https://github.com/seayoo-io/combo-sdk-node",
  "keywords": [
    "combo",
    "seayoo",
    "server"
  ],
  "author": "seayoo.io",
  "license": "MIT",
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/koa": "^2.13.12",
    "@types/node": "22.20.1",
    "ioredis": "^5.4.1",
    "lint-staged": "^17.3.0",
    "microbundle": "^0.15.1",
    "msw": "^2.15.0",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "rimraf": "^6.1.3",
    "simple-git-hooks": "^2.13.1",
    "typescript": "6.0.3",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "jsonwebtoken": "^9.0.2"
  }
}
